{% extends 'base.html.twig' %}

{% block title %}Prestations de Lavage Auto{% endblock %}

{% block body %}
<div class="cleaning-container">
    <div class="cleaning-image">
        <img src="{{ asset('assets/img/prestation-nettoyage.jpeg') }}" alt="Prestation de lavage auto">
    </div>

    <div class="cleaning-content">
        <h1>Prestations de Lavage Auto</h1>

        <div class="price-box">
            <h3>Formule Complète - 99€</h3>
            <p><strong>Intérieur & Extérieur</strong></p>

            <h2>Intérieur</h2>
            <ul>
                <li>Dépoussiérage</li>
                <li>Aspirateur habitacle et coffre</li>
                <li>Nettoyage des plastiques</li>
                <li>Nettoyage des vitres</li>
                <li>Parfum</li>
            </ul>

            <h2>Extérieur</h2>
            <ul>
                <li>Lavage carrosserie</li>
                <li>Lavage des jantes</li>
                <li>Brillant à pneus</li>
            </ul>
        </div>

        <h2>Autres Services</h2>
        <div class="price-box">
            <div class="price-item">
                <span>Shampouinage des sièges</span>
                <strong>50€</strong>
            </div>
            <div class="price-item">
                <span>Lustrage carrosserie</span>
                <strong>199€</strong>
            </div>
            <div class="price-item">
                <span>Rénovation optiques</span>
                <strong>30€ / phare</strong>
            </div>
        </div>
    </div>
</div>
{% endblock %}
