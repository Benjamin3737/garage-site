<!DOCTYPE html>
<html class="h-100">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block stylesheets %}{% endblock %}

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Overpass:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Sen:wght@400..800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/app.css">

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>

    <body class="d-flex flex-column">
        <nav class="navbar flex-column">
            <div class="">
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('assets/img/logo-05.png') }}" alt="Logo" style="width: 50px;">
                </a>
                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Ouvrir le menu">
                    <span class="nav-toggle-bar"></span>
                </button>
            </div>
            <h1 class="mt-2 mb-3">Julien Automobiles</h1>
            <div id="nav-links" class="nav-links gap-4 mt-2">
                <a class="nav-link text-white" href="{{ path('app_annonces') }}">Véhicules</a>
                <a class="nav-link text-white" href="{{ path('app_services') }}">Prestations atelier</a>
                <a class="nav-link text-white" href="{{ path('app_cleaning') }}">Prestations Nettoyage</a>
                <a class="nav-link text-white" href="{{ path('app_home') }}#contact">Contact</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link text-white" href="{{ path('app_admin_dashboard') }}">Admin</a>
                {% endif %}
                {% if app.user %}
                    <a class="nav-link text-white" href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a class="nav-link text-white" href="{{ path('app_login') }}">Connexion</a>
                    <a class="nav-link text-white" href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>
        </nav>

        {% if app.flashes|length > 0 %}
            <div class="container mt-3">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <div class="main-content">
            {% block body %}{% endblock %}
        </div>

        <footer class="footer">
            <div class="footer-container">
                <div class="column1">
                    <h6>Contact</h6>
                    <p><i class="fas fa-map-marker-alt"></i> 2 rue du Clos au blé, 76530 Grand Couronne</p>
                    <p><i class="fas fa-phone"></i> 06 72 38 37 36</p>
                    <p><i class="fas fa-envelope"></i> julienautomobiles76@gmail.com</p>

                    <h6 class="mt-4">Horaires</h6>
                    <p>Lundi - Vendredi : 9h30 - 18h00</p>
                    <p>Le samedi sur Rendez-Vous</p>
                </div>

                <div class="column2">
                    <h6>Consulter</h6>
                    <p><a class="text-white" href="{{ path('app_annonces') }}">Véhicules</a></p>
                    <p><a class="text-white" href="{{ path('app_services') }}">Prestations atelier</a></p>
                    <p><a class="text-white" href="{{ path('app_cleaning') }}">Prestations nettoyage</a></p>
                    <p><a class="text-white" href="{{ path('app_home') }}#contact">Contact</a></p>

                    <h6 class="mt-4">Suivez-nous sur nos réseaux</h6>
                    <div class="socials">
                        <i class="fa-brands fa-facebook"></i>
                    </div>
                </div>

                <div class="footer-map">
                    <div id="map">
                        <iframe width="100%" height="300" style="border: 0; border-radius: 8px;" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=0.9965%2C49.3504%2C1.0165%2C49.3704&layer=mapnik&marker=49.3604%2C1.0065"></iframe>
                    </div>
                </div>
            </div>

            <div class="Mentions-legales">
                © 2026 - Julien Automobiles -
                <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
            </div>
        </footer>
    </body>
</html>