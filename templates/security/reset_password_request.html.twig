{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 480px; margin: 0 auto;">
    <h2 class="text-white mb-4">Mot de passe oublié</h2>

    {{ form_start(requestForm, {'attr': {'class': 'bg-dark p-4 rounded-4', 'style': 'background: #111827; border: 1px solid #1e3a5f;'}}) }}
        <div class="mb-3">
            {{ form_label(requestForm.email, null, {'label_attr': {'class': 'form-label text-white'}}) }}
            {{ form_widget(requestForm.email, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <button type="submit" class="btn btn-primary w-100" style="background: #185fa5; border: none;">Envoyer le lien de réinitialisation</button>
    {{ form_end(requestForm) }}

    <p class="text-white mt-3">Se souvenir du mot de passe ? <a href="{{ path('app_login') }}">Connexion</a></p>
</section>
{% endblock %}
