{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 480px; margin: 0 auto;">
    <h2 class="text-white mb-4">Réinitialiser le mot de passe</h2>

    {{ form_start(resetForm, {'attr': {'class': 'bg-dark p-4 rounded-4', 'style': 'background: #111827; border: 1px solid #1e3a5f;'}}) }}
        <div class="mb-3">
            {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(resetForm.plainPassword.first) }}
        </div>

        <div class="mb-3">
            {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(resetForm.plainPassword.second) }}
        </div>

        <button type="submit" class="btn btn-primary w-100" style="background: #185fa5; border: none;">Réinitialiser</button>
    {{ form_end(resetForm) }}

    <p class="text-white mt-3">Retour à la connexion ? <a href="{{ path('app_login') }}">Se connecter</a></p>
</section>
{% endblock %}
