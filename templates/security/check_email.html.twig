{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre email{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 480px; margin: 0 auto;">
    <div class="bg-dark p-4 rounded-4" style="background: #111827; border: 1px solid #1e3a5f;">
        <h2 class="text-white mb-4">Vérifiez votre email</h2>
        <p class="text-white">Un lien de réinitialisation a été envoyé à l'adresse que vous avez indiquée.</p>
        <p class="text-white">Si vous ne le voyez pas, pensez à vérifier votre dossier spam.</p>
        <p class="mt-3"><a href="{{ path('app_login') }}">Retour à la page de connexion</a></p>
    </div>
</section>
{% endblock %}
