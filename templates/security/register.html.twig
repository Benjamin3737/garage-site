{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 480px; margin: 0 auto;">
    <h2 class="text-white mb-4">Inscription</h2>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {{ form_start(registrationForm, {'attr': {'class': 'bg-dark p-4 rounded-4', 'style': 'background: #111827; border: 1px solid #1e3a5f;'}}) }}
        {% if registrationForm.vars.errors|length > 0 %}
            <div class="alert alert-danger">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label text-white'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'form-label text-white'}}) }}
            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'form-label text-white'}}) }}
            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'style': 'border-radius: 8px;'}}) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        {{ form_errors(registrationForm.plainPassword) }}

        <button type="submit" class="btn btn-primary w-100" style="background: #185fa5; border: none;">Créer un compte</button>
    {{ form_end(registrationForm) }}

    <p class="text-white mt-3">Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Connexion</a></p>
</section>
{% endblock %}
